---
// src/components/CostComparison.astro
---
<section class="not-content py-16 px-4">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl font-bold text-center mb-8">Save on Every Session</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-gray-600">
            <th class="py-3 px-4">Mode</th>
            <th class="py-3 px-4">Claude Tokens Used</th>
            <th class="py-3 px-4">Estimated Cost</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-700/50">
            <td class="py-3 px-4">Claude-only</td>
            <td class="py-3 px-4">100%</td>
            <td class="py-3 px-4">$$$</td>
          </tr>
          <tr class="border-b border-gray-700/50 text-teal-400 font-semibold">
            <td class="py-3 px-4">Hybrid (locode)</td>
            <td class="py-3 px-4">~40–60%</td>
            <td class="py-3 px-4">$</td>
          </tr>
          <tr>
            <td class="py-3 px-4">Local-only</td>
            <td class="py-3 px-4">0%</td>
            <td class="py-3 px-4">Free</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-center text-sm opacity-60 mt-4">Run <code>locode benchmark</code> to see your own savings.</p>
  </div>
</section>
