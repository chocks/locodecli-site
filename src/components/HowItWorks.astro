---
// src/components/HowItWorks.astro
---
<section class="not-content py-16 px-4">
  <h2 class="text-2xl font-bold text-center mb-12">How It Works</h2>
  <div class="max-w-4xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 rounded-full bg-teal-500/10 flex items-center justify-center mb-4 text-2xl">1</div>
        <h3 class="text-lg font-semibold mb-2">You type</h3>
        <p class="text-sm opacity-75">Write your prompt — a question, a task, a code request.</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 rounded-full bg-teal-500/10 flex items-center justify-center mb-4 text-2xl">2</div>
        <h3 class="text-lg font-semibold mb-2">Locode routes</h3>
        <p class="text-sm opacity-75">Smart classification decides which model handles your task.</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 rounded-full bg-teal-500/10 flex items-center justify-center mb-4 text-2xl">3</div>
        <h3 class="text-lg font-semibold mb-2">Right model responds</h3>
        <p class="text-sm opacity-75">Ollama for simple tasks (free). Claude for complex ones (powerful).</p>
      </div>
    </div>
  </div>
</section>
